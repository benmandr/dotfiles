{
    "layer": "top",
    "position": "top",
    "margin-top": 5,
    "margin-left": 10,
    "margin-right": 10,
    "height": 20,
    "spacing": 0,
    "modules-left": [
        "custom/weather",
        "battery",
        "custom/cpu",
        "custom/waybar-media",
        "custom/media-previous",
        "custom/cava",
        "custom/media-next",
        "custom/media"
    ],
    "modules-center": [
        "custom/screen-recorder",
        "sway/workspaces"
    ],
    "modules-right": [
        "network",
        "custom/vpn",
        "bluetooth",
        "clock"
    ],
    "sway/workspaces": {
        "all-outputs": true,
        "format": "{icon}",
        "disable-scroll": true,
        "format-icons": {
            "default": "",
            "focused": "",
            "urgent": ""
        }
    },
    "battery": {
        "format": "&#xf0079;  {capacity}%",
        "format-charging": "&#xf0084;  {capacity}%",
        "states": {
            "critical": 15
        },
        "interval": 5
    },
    "memory": {
        "format": "  &#xefc5;    {percentage}%",
        "interval": 5,
        "states": {
            "warning": 80
        }
    },
    "clock": {
        "format": "    {:%H:%M:%S     %m/%d}",
        "interval": 1,
        "tooltip": false
    },
    "network": {
        "format": "⚠",
        "format-wifi": "",
        "format-disconnected": "⚠",
        "tooltip-format": "{essid}"
    },
    "bluetooth": {
        "format": "    ",
        "format-connected": "    ",
        "tooltip-format": "No connections",
        "tooltip-format-connected": "{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t 󰁹  {device_battery_percentage}%",
        "on-click": "exec blueman-manager"
    },
    "custom/cpu": {
        "format": " &#xf4bc;   {}",
        "interval": 1,
        "exec": "~/.config/waybar/cpu.sh",
        "return-type": "json",
        "tooltip": true
    },
    "custom/weather": {
        "format": "{}",
        "interval": 3600,
        "exec": "~/.config/waybar/weather.sh",
        "tooltip": false,
        "on-click": "xdg-open https://wttr.in/Kaunas?m"
    },
    "custom/screen-recorder": {
        "format": "    ",
        "return-type": "json",
        "interval": 5,
        "exec": "echo '{\"class\": \"recording\"}'",
        "exec-if": "pgrep -x wf-recorder"
    },
    "custom/vpn": {
        "format": "{}",
        "return-type": "json",
        "interval": 1800,
        "exec": "~/.config/waybar/vpn.sh",
        "on-click": "~/.config/waybar/vpn-toggle.sh",
        "tooltip": true,
        "signal": 8
    },
    "custom/media": {
        "format": "   {}",
        "exec": "playerctl metadata --format '{{artist}} - {{title}}'",
        "interval": 1,
        "limit": 60,
        "tooltip": false,
        "on-click": "swaymsg [app_id='zen-beta'] focus && wtype -M alt -M shift a"
    },
    "custom/media-previous": {
        "format": "  ",
        "tooltip": false,
        "on-click": "playerctl previous"
    },
    "custom/media-next": {
        "format": "   ",
        "tooltip": false,
        "on-click": "playerctl next"
    },
    "custom/cava": {
        "format": "  {}",
        "exec": "~/.config/waybar/cava.sh",
        "tooltip": false,
        "on-click": "playerctl play-pause"
    }
}